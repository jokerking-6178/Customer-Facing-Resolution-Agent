# Copy to .env and fill in. The app loads .env automatically (backend/config.py).
# A real environment variable always wins over this file.

# LLM provider: mock | ollama | groq
LLM_PROVIDER=groq

# Groq (hosted, free tier) -- required when LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here

# Optional overrides.
# Groq retires hosted models periodically; if you get a 404, list the models
# your key can reach with:
#   python -m backend.llm.provider
# LLM_MODEL=openai/gpt-oss-120b     # Groq default
# LLM_MODEL=llama3.1:8b             # Ollama default
# LLM_BASE_URL=http://localhost:11434/v1
# DB_PATH=backend/data/skyassist.db
